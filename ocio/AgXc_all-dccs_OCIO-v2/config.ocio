# version: 1.0.0.rc.5
# name: AgXc
# variant: all-dccs_OCIO-v2
# built-on: 2025-02-27 17:31:34.867240
# previous-commit-hash: 31b9f4d8367c08570f6683fd174d17e11ee2d009
# // visit https://github.com/MrLixm/AgXc
# // and inspect the python build script for details

ocio_profile_version: 2

environment:
  {}
search_path: LUTs
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
name: AgXc
description: |
  AgX image rendering initially designed by Troy Sobotka.
  Adapted by Liam Collod with full permissions from Troy Sobotka.
  C.A.T. used for whitepoint conversions is <Bradford>.

roles:
  aces_interchange: ACES2065-1
  cie_xyz_d65_interchange: CIE-XYZ-D65
  color_picking: Linear Rec.2020
  color_timing: sRGB-2.2
  compositing_log: AgXc Log
  data: Raw
  default: Linear Rec.2020
  default_byte: sRGB-texture
  default_float: Linear Rec.709 (sRGB)
  default_sequencer: Linear Rec.2020
  matte_paint: sRGB-2.2
  reference: Linear Rec.709 (sRGB)
  scene_linear: Linear Rec.2020
  texture_paint: sRGB-texture

file_rules:
  # --- named pattern rules (pipeline naming conventions, highest priority) ---
  - !<Rule> {name: srgb_tx,       colorspace: sRGB-texture,   pattern: "*srgb_tx*",       extension: "*"}
  - !<Rule> {name: srgb_texture,  colorspace: sRGB-texture,   pattern: "*srgb_texture*",  extension: "*"}
  - !<Rule> {name: lin_rec709,    colorspace: Linear Rec.709 (sRGB),    pattern: "*lin_rec709*",    extension: "*"}
  - !<Rule> {name: lin_srgb,      colorspace: Linear Rec.709 (sRGB),    pattern: "*lin_srgb*",      extension: "*"}
  - !<Rule> {name: lin_rec2020,   colorspace: Linear Rec.2020, pattern: "*lin_rec2020*",   extension: "*"}
  - !<Rule> {name: lin_rec2020_legacy, colorspace: Linear Rec.2020, pattern: "*lin_bt2020*", extension: "*"}
  - !<Rule> {name: acescg,        colorspace: ACEScg,         pattern: "*ACEScg*",        extension: "*"}
  # --- USD/USDZ embedded texture rules ---
  - !<Rule> {name: __usdz_jpg,    colorspace: sRGB-texture,   regex: ".[uu][ss][dd][zz]\\[.*[jj][pp][gg]\\]"}
  - !<Rule> {name: __usdz_jpeg,   colorspace: sRGB-texture,   regex: ".[uu][ss][dd][zz]\\[.*[jj][pp][ee][gg]\\]"}
  - !<Rule> {name: __usdz_png,    colorspace: sRGB-texture,   regex: ".[uu][ss][dd][zz]\\[.*[pp][nn][gg]\\]"}
  - !<Rule> {name: __usdz_tif,    colorspace: sRGB-texture,   regex: ".[uu][ss][dd][zz]\\[.*[tt][ii][ff]\\]"}
  - !<Rule> {name: __usdz_tiff,   colorspace: sRGB-texture,   regex: ".[uu][ss][dd][zz]\\[.*[tt][ii][ff][ff]\\]"}
  - !<Rule> {name: __usdz_exr,    colorspace: Linear Rec.2020, regex: ".[uu][ss][dd][zz]\\[.*[ee][xx][rr]\\]"}
  # --- extension fallbacks ---
  - !<Rule> {name: jpg,           colorspace: sRGB-texture,   pattern: "*", extension: jpg}
  - !<Rule> {name: jpeg,          colorspace: sRGB-texture,   pattern: "*", extension: jpeg}
  - !<Rule> {name: png,           colorspace: sRGB-texture,   pattern: "*", extension: png}
  - !<Rule> {name: tif,           colorspace: sRGB-texture,   pattern: "*", extension: tif}
  - !<Rule> {name: tiff,          colorspace: sRGB-texture,   pattern: "*", extension: tiff}
  - !<Rule> {name: exr,           colorspace: Linear Rec.2020, pattern: "*", extension: exr}
  - !<Rule> {name: Default,       colorspace: Linear Rec.2020}

displays:
  sRGB - Display:
    - !<View> {name: AgXc Base - Punchy, colorspace: AgXc Base - Punchy - sRGB - Display}
    - !<View> {name: AgXc Base - Punchy - Custom, colorspace: AgXc Base - Punchy - Custom - sRGB - Display}
    - !<View> {name: AgXc Base, colorspace: AgXc Base - sRGB - Display}
    - !<View> {name: AgXc Base - Custom, colorspace: AgXc Base - Custom - sRGB - Display}
    - !<View> {name: AgXc Softer - Punchy, colorspace: AgXc Softer - Punchy - sRGB - Display}
    - !<View> {name: AgXc Softer - Punchy - Custom, colorspace: AgXc Softer - Punchy - Custom - sRGB - Display}
    - !<View> {name: AgXc Softer, colorspace: AgXc Softer - sRGB - Display}
    - !<View> {name: AgXc Softer - Custom, colorspace: AgXc Softer - Custom - sRGB - Display}
    - !<View> {name: Raw, colorspace: Raw}
    - !<View> {name: Display Encoding, colorspace: sRGB-2.2}
active_displays: [sRGB - Display]
active_views: []
inactive_colorspaces: [AgXc Base - Punchy - sRGB - Display, AgXc Base - Punchy - Display P3 - Display,
                        AgXc Base - Punchy - Rec.1886 - Display, AgXc Base - sRGB - Display,
                        AgXc Base - Display P3 - Display, AgXc Base - Rec.1886 - Display,
                        AgXc Base - Punchy - Custom - sRGB - Display, AgXc Base - Punchy - Custom - Display P3 - Display,
                        AgXc Base - Punchy - Custom - Rec.1886 - Display, AgXc Base - Custom - sRGB - Display,
                        AgXc Base - Custom - Display P3 - Display, AgXc Base - Custom - Rec.1886 - Display,
                        AgXc Softer - Punchy - sRGB - Display, AgXc Softer - Punchy - Display P3 - Display,
                        AgXc Softer - Punchy - Rec.1886 - Display, AgXc Softer - Custom - sRGB - Display,
                        AgXc Softer - Custom - Display P3 - Display, AgXc Softer - Custom - Rec.1886 - Display,
                        AgXc Softer - Punchy - Custom - sRGB - Display, AgXc Softer - Punchy - Custom - Display P3 - Display,
                        AgXc Softer - Punchy - Custom - Rec.1886 - Display, AgXc Softer - sRGB - Display,
                        AgXc Softer - Display P3 - Display, AgXc Softer - Rec.1886 - Display]

looks:
  - !<Look>
    name: Punchy
    process_space: Linear Rec.2020
    description: A punchy and more chroma laden look.
    transform: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Log}
        - !<FileTransform> {src: saturation-max-2.cube, interpolation: tetrahedral}
        - !<CDLTransform> {slope: [1.01, 1.01, 1.01], offset: [0.038, 0.038, 0.038], power: [1.24, 1.24, 1.24]}
        - !<ColorSpaceTransform> {src: AgXc Log, dst: reference}

  - !<Look>
    name: CustomCDL
    process_space: Linear Rec.2020
    description: Reusable custom CDL stack.
    transform: !<GroupTransform>
      children:
        - !<CDLTransform> {slope: [1.9, 1.9, 1.9], power: [1.34, 1.34, 1.34], saturation: 1.32}
        - !<CDLTransform> {slope: [1.12, 1.08, 0.96], offset: [0.0015, 0.0035, 0.0], power: [1.02, 1.02, 1.02], saturation: 1.16}
        - !<CDLTransform> {slope: [1.02, 1.02, 1.02], power: [1.4, 1.4, 1.4]}


colorspaces:
  - !<ColorSpace>
    name: sRGB-2.2
    aliases: [g22_rec709, g22_encoded_rec709, Gamma 2.2 Encoded Rec.709]
    family: Utility
    equalitygroup: ""
    bitdepth: unknown
    description: sRGB with 2.2 power function transfer-function.
    isdata: false
    allocation: uniform
    from_scene_reference: !<ExponentTransform> {value: 2.2, direction: inverse}

  - !<ColorSpace>
    name: sRGB-texture
    aliases: [sRGB Encoded Rec.709 (sRGB), sRGB - Texture, srgb_encoded_rec709_srgb, srgb_tx, srgb_texture, Input - Generic - sRGB - Texture, Utility - sRGB - Texture]
    family: Utility
    equalitygroup: ""
    bitdepth: unknown
    description: |
      sRGB IEC 61966-2-1 2.2 Exponent Reference EOTF Display.
      This colorspace is required by Redshift to work.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ExponentWithLinearTransform> {gamma: 2.4, offset: 0.055, direction: inverse}
        - !<RangeTransform> {min_in_value: 0, max_in_value: 1, min_out_value: 0, max_out_value: 1}

  - !<ColorSpace>
    name: Display-P3
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: Display P3 2.2 Exponent EOTF Display. For Apple hardware.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [0.868579739716, 0.128919138461, 0.002501121823, 0, 0.034540410254, 0.961811386362, 0.003648203384, 0, 0.016771429041, 0.071039997787, 0.912188573172, 0, 0, 0, 0, 1]}
        - !<ExponentTransform> {value: 2.2, direction: inverse}

  - !<ColorSpace>
    name: BT.1886
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: sRGB primaries, D65 whitepoint and 2.4 Exponent EOTF. Also known as Rec.709.
    isdata: false
    allocation: uniform
    from_scene_reference: !<ExponentTransform> {value: 2.4, direction: inverse}

  - !<ColorSpace>
    name: AgXc Log
    aliases: [AgXc-log]
    family: Colorspaces
    equalitygroup: ""
    bitdepth: 32f
    description: AgX Log encoding.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<RangeTransform> {min_in_value: 0, min_out_value: 0}
        - !<AllocationTransform> {allocation: lg2, vars: [-12.47393, 4.026069]}

  - !<ColorSpace>
    name: AgXc Base
    aliases: [AgXc.base]
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: |
      AgXc image rendering transform.
      Output is encoded in working colorspace.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: Linear Rec.2020}
        - !<MatrixTransform> {matrix: [0.472738636743224, 0.12687790806726, 0.400383455189515, 0, 0.186381444574505, 0.589240731652576, 0.224377823772918, 0, 0.134783472151827, 0.166178005290661, 0.699038522557512, 0, 0, 0, 0, 1]}
        - !<AllocationTransform> {allocation: lg2, vars: [-10, 15]}
        - !<FileTransform> {src: luminance-compensation.cube, interpolation: linear}
        - !<AllocationTransform> {allocation: lg2, vars: [-10, 15], direction: inverse}
        - !<MatrixTransform> {matrix: [0.608094094577481, 0.241305765375846, 0.150600140046673, 0, 0.267115783780114, 0.414480014218567, 0.318404202001318, 0, 0.16226708474612, 0.0674729411942575, 0.770259974059622, 0, 0, 0, 0, 1]}
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Log}
        - !<FileTransform> {src: AgX-tonescale-default.spi1d, interpolation: linear}
        - !<MatrixTransform> {matrix: [1.70401243235717, -0.279876242822721, -0.424136189534447, 0, -0.482927084048831, 1.90706327358328, -0.424136189534447, 0, -0.48292708404883, -0.279876242822721, 1.76280332687155, 0, 0, 0, 0, 1]}
        - !<MatrixTransform> {matrix: [1.660491002108, -0.587641138789, -0.07284986332, 0, -0.124550474522, 1.132899897126, -0.008349422604, 0, -0.018150763355, -0.100578898008, 1.118729661363, 0, 0, 0, 0, 1]}
        - !<ExponentTransform> {value: 2.4}

  - !<ColorSpace>
    name: AgXc Softer
    aliases: [AgXc.softer]
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: |
      AgXc image rendering transform.
      The tonescale produce a softer result in highlights.Output is encoded in working colorspace.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: Linear Rec.2020}
        - !<MatrixTransform> {matrix: [0.472738636743224, 0.12687790806726, 0.400383455189515, 0, 0.186381444574505, 0.589240731652576, 0.224377823772918, 0, 0.134783472151827, 0.166178005290661, 0.699038522557512, 0, 0, 0, 0, 1]}
        - !<AllocationTransform> {allocation: lg2, vars: [-10, 15]}
        - !<FileTransform> {src: luminance-compensation.cube, interpolation: linear}
        - !<AllocationTransform> {allocation: lg2, vars: [-10, 15], direction: inverse}
        - !<MatrixTransform> {matrix: [0.608094094577481, 0.241305765375846, 0.150600140046673, 0, 0.267115783780114, 0.414480014218567, 0.318404202001318, 0, 0.16226708474612, 0.0674729411942575, 0.770259974059622, 0, 0, 0, 0, 1]}
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Log}
        - !<FileTransform> {src: AgX-tonescale-hardtoe.spi1d, interpolation: linear}
        - !<MatrixTransform> {matrix: [1.70401243235717, -0.279876242822721, -0.424136189534447, 0, -0.482927084048831, 1.90706327358328, -0.424136189534447, 0, -0.48292708404883, -0.279876242822721, 1.76280332687155, 0, 0, 0, 0, 1]}
        - !<MatrixTransform> {matrix: [1.660491002108, -0.587641138789, -0.07284986332, 0, -0.124550474522, 1.132899897126, -0.008349422604, 0, -0.018150763355, -0.100578898008, 1.118729661363, 0, 0, 0, 0, 1]}
        - !<CDLTransform> {slope: [0.82, 0.82, 0.82]}

  - !<ColorSpace>
    name: AgXc Tonescale - Default
    aliases: [AgXc-tonescale-default]
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: AgXc 1D curve. Output is linear.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Log}
        - !<FileTransform> {src: AgX-tonescale-default.spi1d, interpolation: linear}
        - !<ExponentTransform> {value: 2.4}

  - !<ColorSpace>
    name: Raw
    aliases: [Raw, Passthrough, none, Utility - Raw]
    family: Utility
    equalitygroup: scalar
    bitdepth: 32f
    description: Passthrough means no transformations. Also know as "raw".
    isdata: true
    allocation: uniform

  - !<ColorSpace>
    name: Linear Rec.709 (sRGB)
    aliases: [lin_rec709_srgb, lin_rec709, lin_srgb, sRGB-linear, Utility - Linear - Rec.709, Utility - Linear - sRGB]
    family: Utility
    equalitygroup: ""
    bitdepth: 32f
    description: Standard sRGB colorspace with linear transfer-function.
    isdata: false
    allocation: uniform

  - !<ColorSpace>
    name: ACEScg
    aliases: [lin_ap1, lin_ap1_scene, ACES - ACEScg]
    family: ACES
    equalitygroup: ""
    bitdepth: 32f
    description: ACES rendering space for CGI. Also known as AP1.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [0.613097402401, 0.339523146184, 0.047379451415, 0, 0.07019372247, 0.916353879057, 0.013452398473, 0, 0.020615592882, 0.109569772938, 0.86981463418, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: ACES2065-1
    aliases: [lin_ap0, lin_ap0_scene, aces2065_1, aces, ACES - ACES2065-1]
    family: ACES
    equalitygroup: ""
    bitdepth: 32f
    description: ACES Interchange format. Also known as AP0.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [0.439632981919, 0.382988698152, 0.177378319929, 0, 0.089776442959, 0.813439428749, 0.096784128292, 0, 0.017541170383, 0.111546553302, 0.870912276314, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: CIE-XYZ-D65
    aliases: [lin_ciexyzd65_scene, cie_xyz_d65_scene, CIE XYZ-D65 - Scene-referred]
    family: Utility
    equalitygroup: ""
    bitdepth: 32f
    description: CIE 1931 Colorspace with a D65 whitepoint.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [0.412390799266, 0.357584339384, 0.180480788402, 0, 0.212639005872, 0.715168678768, 0.072192315361, 0, 0.019330818716, 0.119194779795, 0.95053215225, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: Linear Rec.2020
    aliases: [lin_bt2020, lin_rec2020, BT.2020-linear, Utility - Linear - Rec.2020]
    family: Utility
    equalitygroup: ""
    bitdepth: 32f
    description: |
      The ITU-R BT.2020 colorspace with a linear transfer-function.
      A very wide gamut on the edge of the spectral locus, with a D65 whitepoint.
      Also the reference/working colorspace for this config.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [0.627403895935, 0.329283038378, 0.043313065687, 0, 0.069097289358, 0.919540395075, 0.011362315566, 0, 0.016391438875, 0.088013307877, 0.895595253248, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: AgXc Base - Punchy - sRGB - Display
    aliases: [Image AgXc.base-Punchy sRGB-2.2]
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc.base image rendering transform
      - the Punchy look transform
      - a conversion for sRGB-2.2 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Base}
        - !<LookTransform> {src: Linear Rec.2020, dst: Linear Rec.2020, looks: Punchy}
        - !<ColorSpaceTransform> {src: Linear Rec.2020, dst: sRGB-2.2}

  - !<ColorSpace>
    name: AgXc Base - Punchy - Display P3 - Display
    aliases: [Image AgXc.base-Punchy Display-P3]
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc.base image rendering transform
      - the Punchy look transform
      - a conversion for Display-P3 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Base}
        - !<LookTransform> {src: Linear Rec.2020, dst: Linear Rec.2020, looks: Punchy}
        - !<ColorSpaceTransform> {src: Linear Rec.2020, dst: Display-P3}

  - !<ColorSpace>
    name: AgXc Base - Punchy - Rec.1886 - Display
    aliases: [Image AgXc.base-Punchy BT.1886]
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc.base image rendering transform
      - the Punchy look transform
      - a conversion for BT.1886 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Base}
        - !<LookTransform> {src: Linear Rec.2020, dst: Linear Rec.2020, looks: Punchy}
        - !<ColorSpaceTransform> {src: Linear Rec.2020, dst: BT.1886}

  - !<ColorSpace>
    name: AgXc Base - Punchy - Custom - sRGB - Display
    aliases: [Image AgXc.base-Punchy-custom sRGB-2.2]
    family: Views
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - 3 CDL nodes in Linear Rec.2020, before display rendering
      - the AgXc.base image rendering transform
      - the Punchy look transform
      - a conversion for sRGB-2.2 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<LookTransform> {src: reference, dst: reference, looks: CustomCDL}
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Base}
        - !<LookTransform> {src: Linear Rec.2020, dst: Linear Rec.2020, looks: Punchy}
        - !<ColorSpaceTransform> {src: Linear Rec.2020, dst: sRGB-2.2}

  - !<ColorSpace>
    name: AgXc Base - Punchy - Custom - Display P3 - Display
    aliases: [Image AgXc.base-Punchy-custom Display-P3]
    family: Views
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - 3 CDL nodes in Linear Rec.2020, before display rendering
      - the AgXc.base image rendering transform
      - the Punchy look transform
      - a conversion for Display-P3 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<LookTransform> {src: reference, dst: reference, looks: CustomCDL}
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Base}
        - !<LookTransform> {src: Linear Rec.2020, dst: Linear Rec.2020, looks: Punchy}
        - !<ColorSpaceTransform> {src: Linear Rec.2020, dst: Display-P3}

  - !<ColorSpace>
    name: AgXc Base - Punchy - Custom - Rec.1886 - Display
    aliases: [Image AgXc.base-Punchy-custom BT.1886]
    family: Views
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - 3 CDL nodes in Linear Rec.2020, before display rendering
      - the AgXc.base image rendering transform
      - the Punchy look transform
      - a conversion for BT.1886 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<LookTransform> {src: reference, dst: reference, looks: CustomCDL}
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Base}
        - !<LookTransform> {src: Linear Rec.2020, dst: Linear Rec.2020, looks: Punchy}
        - !<ColorSpaceTransform> {src: Linear Rec.2020, dst: BT.1886}

  - !<ColorSpace>
    name: AgXc Base - sRGB - Display
    aliases: [Image AgXc.base sRGB-2.2]
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc.base image rendering transform
      - a conversion for sRGB-2.2 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Base}
        - !<ColorSpaceTransform> {src: Linear Rec.2020, dst: sRGB-2.2}

  - !<ColorSpace>
    name: AgXc Base - Display P3 - Display
    aliases: [Image AgXc.base Display-P3]
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc.base image rendering transform
      - a conversion for Display-P3 display standard.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: reference, dst: AgXc Base}
        - !<ColorSpaceTransform> {src: Linear Rec.2020, dst: Display-P3}

  - !<ColorSpace>
    name: AgXc Base - Rec.1886 - Display
    aliases: [Image AgXc.base BT.1886]
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: |
      A display-referred/display-ready colorspace. Built with:
      - the AgXc.base image rendering transform
      - a conversion for BT.1886 display standard.
    isdata: false
