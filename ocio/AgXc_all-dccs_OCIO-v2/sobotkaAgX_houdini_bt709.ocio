ocio_profile_version: 2

# Derived from Troy Sobotka's AgX (https://github.com/sobotka/AgX).
# Houdini-ready variant — Linear BT.709 scene/reference space.
# Adds: piecewise sRGB-texture, ACES interchange spaces, BT.2020-linear,
#        pipeline aliases, file rules, and Houdini UI cleanup.
#
# PREREQUISITE: LUTs/AgX_Default_Contrast.spi1d must be present.
# Source: https://github.com/sobotka/AgX/blob/main/LUTs/AgX_Default_Contrast.spi1d

environment:
  {}
search_path: LUTs
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]

roles:
  aces_interchange: ACES2065-1
  cie_xyz_d65_interchange: CIE-XYZ-D65
  color_picking: Linear BT.709
  color_timing: sRGB-texture
  compositing_log: AgX Log (Kraken)
  data: Generic Data
  default: sRGB-texture
  default_byte: sRGB-texture
  default_float: Linear BT.709
  default_sequencer: Linear BT.709
  matte_paint: sRGB-texture
  reference: Linear BT.709
  scene_linear: Linear BT.709
  texture_paint: sRGB-texture

file_rules:
  - !<Rule> {name: srgb_tx,      colorspace: sRGB-texture,   pattern: "*srgb_tx*",      extension: "*"}
  - !<Rule> {name: srgb_texture, colorspace: sRGB-texture,   pattern: "*srgb_texture*", extension: "*"}
  - !<Rule> {name: lin_rec709,   colorspace: Linear BT.709,  pattern: "*lin_rec709*",   extension: "*"}
  - !<Rule> {name: lin_srgb,     colorspace: Linear BT.709,  pattern: "*lin_srgb*",     extension: "*"}
  - !<Rule> {name: lin_bt2020,   colorspace: BT.2020-linear, pattern: "*lin_bt2020*",   extension: "*"}
  - !<Rule> {name: acescg,       colorspace: ACEScg,         pattern: "*ACEScg*",       extension: "*"}
  - !<Rule> {name: jpg,          colorspace: sRGB-texture,   pattern: "*",              extension: jpg}
  - !<Rule> {name: jpeg,         colorspace: sRGB-texture,   pattern: "*",              extension: jpeg}
  - !<Rule> {name: png,          colorspace: sRGB-texture,   pattern: "*",              extension: png}
  - !<Rule> {name: tif,          colorspace: sRGB-texture,   pattern: "*",              extension: tif}
  - !<Rule> {name: tiff,         colorspace: sRGB-texture,   pattern: "*",              extension: tiff}
  - !<Rule> {name: exr,          colorspace: Linear BT.709,  pattern: "*",              extension: exr}
  - !<Rule> {name: Default,      colorspace: Linear BT.709}

displays:
  sRGB:
    - !<View> {name: Display Native, colorspace: sRGB}
    - !<View> {name: AgX, colorspace: AgX Base}
    - !<View> {name: Appearance Golden, colorspace: Appearance Golden sRGB}
    - !<View> {name: Appearance Punchy, colorspace: Appearance Punchy sRGB}
    - !<View> {name: Raw, colorspace: Generic Data}
  Display P3:
    - !<View> {name: Display Native, colorspace: Display P3}
    - !<View> {name: AgX, colorspace: AgX Base Display P3}
    - !<View> {name: Appearance Golden, colorspace: Appearance Golden Display P3}
    - !<View> {name: Appearance Punchy, colorspace: Appearance Punchy Display P3}
    - !<View> {name: Raw, colorspace: Generic Data}
  BT.1886:
    - !<View> {name: Display Native, colorspace: BT.1886}
    - !<View> {name: AgX, colorspace: AgX Base BT.1886}
    - !<View> {name: Appearance Golden, colorspace: Appearance Golden BT.1886}
    - !<View> {name: Appearance Punchy, colorspace: Appearance Punchy BT.1886}
    - !<View> {name: Raw, colorspace: Generic Data}

active_displays: [sRGB, Display P3, BT.1886]
active_views: []
inactive_colorspaces: [AgX Base BT.1886, AgX Base Display P3,
                        Appearance Golden sRGB, Appearance Golden Display P3, Appearance Golden BT.1886,
                        Appearance Punchy sRGB, Appearance Punchy Display P3, Appearance Punchy BT.1886]

looks:
  - !<Look>
    name: Golden
    process_space: AgX Base
    description: A golden tinted, slightly washed look
    transform: !<CDLTransform> {slope: [1, 0.9, 0.5], power: [0.8, 0.8, 0.8], sat: 1.3}

  - !<Look>
    name: Punchy
    process_space: AgX Base
    description: A punchy and more chroma laden look
    transform: !<CDLTransform> {power: [1.35, 1.35, 1.35], sat: 1.4}


colorspaces:
  - !<ColorSpace>
    name: Linear BT.709
    aliases: [Linear, Linear Tristimulus, lin_rec709, lin_srgb, lin_rec709_srgb,
              Linear Rec.709 (sRGB), Utility - Linear - Rec.709, Utility - Linear - sRGB]
    family: Utility
    equalitygroup: ""
    bitdepth: unknown
    description: Open Domain Linear BT.709 Tristimulus. Scene reference and working space.
    isdata: false
    allocation: uniform

  - !<ColorSpace>
    name: AgX Log (Kraken)
    aliases: [Log, AgX Log, Kraken, AgX Kraken Log]
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: AgX Log, (Kraken)
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<RangeTransform> {min_in_value: 0, min_out_value: 0}
        - !<MatrixTransform> {matrix: [0.842479062253094, 0.0784335999999992, 0.0792237451477643, 0, 0.0423282422610123, 0.878468636469772, 0.0791661274605434, 0, 0.0423756549057051, 0.0784336, 0.879142973793104, 0, 0, 0, 0, 1]}
        - !<AllocationTransform> {allocation: lg2, vars: [-12.47393, 4.026069]}

  - !<ColorSpace>
    name: 2.2 EOTF Encoding
    aliases: [sRGB EOTF Encoding]
    family: Utility
    equalitygroup: ""
    bitdepth: unknown
    description: 2.2 Exponent EOTF Encoding
    isdata: false
    allocation: uniform
    from_scene_reference: !<ExponentTransform> {value: 2.2, direction: inverse}

  - !<ColorSpace>
    name: 2.4 EOTF Encoding
    aliases: [BT.1886 EOTF Encoding]
    family: Utility
    equalitygroup: ""
    bitdepth: unknown
    description: 2.4 Exponent EOTF Encoding
    isdata: false
    allocation: uniform
    from_scene_reference: !<ExponentTransform> {value: 2.4, direction: inverse}

  - !<ColorSpace>
    name: sRGB
    aliases: [sRGB-2.2, g22_rec709, g22_encoded_rec709, Gamma 2.2 Encoded Rec.709]
    family: Utility
    equalitygroup: ""
    bitdepth: unknown
    description: sRGB IEC 61966-2-1 2.2 Exponent Reference EOTF Display
    isdata: false
    allocation: uniform
    from_scene_reference: !<ColorSpaceTransform> {src: Linear BT.709, dst: 2.2 EOTF Encoding}

  - !<ColorSpace>
    name: Display P3
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: Display P3 2.2 Exponent EOTF Display
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<MatrixTransform> {matrix: [0.822533651175139, 0.17754580666797, 5.36947712599933e-05, 0, 0.0331170846132368, 0.966848142976822, -3.14995811217383e-06, 0, 0.0170564417474994, 0.0724006113523901, 0.910489265923157, 0, 0, 0, 0, 1]}
        - !<ColorSpaceTransform> {src: Linear BT.709, dst: 2.2 EOTF Encoding}

  - !<ColorSpace>
    name: BT.1886
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: BT.1886 2.4 Exponent EOTF Display
    isdata: false
    allocation: uniform
    from_scene_reference: !<ColorSpaceTransform> {src: Linear BT.709, dst: 2.4 EOTF Encoding}

  - !<ColorSpace>
    name: AgX Base
    family: Colorspaces
    equalitygroup: ""
    bitdepth: unknown
    description: AgX Base Image Encoding
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Linear BT.709, dst: AgX Log (Kraken)}
        - !<FileTransform> {src: AgX_Default_Contrast.spi1d}

  - !<ColorSpace>
    name: AgX Base BT.1886
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: AgX Base Image Encoding for BT.1886 Displays
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Linear BT.709, dst: AgX Base}
        - !<ColorSpaceTransform> {src: 2.2 EOTF Encoding, dst: 2.4 EOTF Encoding}

  - !<ColorSpace>
    name: AgX Base Display P3
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: AgX Base Image Encoding for Display P3 Displays
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Linear BT.709, dst: AgX Base}
        - !<ColorSpaceTransform> {src: 2.2 EOTF Encoding, dst: Display P3}

  - !<ColorSpace>
    name: Appearance Golden sRGB
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: A golden tinted, slightly washed look for sRGB displays
    isdata: false
    allocation: uniform
    from_scene_reference: !<LookTransform> {src: Linear BT.709, dst: AgX Base, looks: Golden}

  - !<ColorSpace>
    name: Appearance Golden Display P3
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: A golden tinted, slightly washed look for Display P3 displays
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<LookTransform> {src: Linear BT.709, dst: AgX Base, looks: Golden}
        - !<ColorSpaceTransform> {src: 2.2 EOTF Encoding, dst: Display P3}

  - !<ColorSpace>
    name: Appearance Golden BT.1886
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: A golden tinted, slightly washed look for BT.1886 displays
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<LookTransform> {src: Linear BT.709, dst: AgX Base, looks: Golden}
        - !<ColorSpaceTransform> {src: 2.2 EOTF Encoding, dst: 2.4 EOTF Encoding}

  - !<ColorSpace>
    name: Appearance Punchy sRGB
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: A punchy and more chroma laden look for sRGB displays
    isdata: false
    allocation: uniform
    from_scene_reference: !<LookTransform> {src: Linear BT.709, dst: AgX Base, looks: Punchy}

  - !<ColorSpace>
    name: Appearance Punchy Display P3
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: A punchy and more chroma laden look for Display P3 displays
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<LookTransform> {src: Linear BT.709, dst: AgX Base, looks: Punchy}
        - !<ColorSpaceTransform> {src: 2.2 EOTF Encoding, dst: Display P3}

  - !<ColorSpace>
    name: Appearance Punchy BT.1886
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: A punchy and more chroma laden look for BT.1886 displays
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<LookTransform> {src: Linear BT.709, dst: AgX Base, looks: Punchy}
        - !<ColorSpaceTransform> {src: 2.2 EOTF Encoding, dst: 2.4 EOTF Encoding}

  - !<ColorSpace>
    name: Generic Data
    aliases: [Non-Color, Raw, Passthrough, none, Utility - Raw]
    family: Utility
    equalitygroup: ""
    bitdepth: unknown
    description: Generic data encoding
    isdata: true
    allocation: uniform

  - !<ColorSpace>
    name: sRGB-texture
    aliases: [sRGB Encoded Rec.709 (sRGB), sRGB - Texture, srgb_encoded_rec709_srgb, srgb_tx, srgb_texture,
              Input - Generic - sRGB - Texture, Utility - sRGB - Texture]
    family: Utility
    equalitygroup: ""
    bitdepth: unknown
    description: |
      sRGB IEC 61966-2-1 piecewise transfer function (2.4 gamma, 0.055 offset).
      The correct ACES sRGB texture space match. Use this for all LDR texture inputs.
    isdata: false
    allocation: uniform
    from_scene_reference: !<GroupTransform>
      children:
        - !<ExponentWithLinearTransform> {gamma: 2.4, offset: 0.055, direction: inverse}
        - !<RangeTransform> {min_in_value: 0, max_in_value: 1, min_out_value: 0, max_out_value: 1}

  - !<ColorSpace>
    name: ACEScg
    aliases: [lin_ap1, lin_ap1_scene, ACES - ACEScg]
    family: ACES
    equalitygroup: ""
    bitdepth: 32f
    description: ACES rendering space for CGI. Also known as AP1.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [0.613097402401, 0.339523146184, 0.047379451415, 0, 0.07019372247, 0.916353879057, 0.013452398473, 0, 0.020615592882, 0.109569772938, 0.86981463418, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: ACES2065-1
    aliases: [aces2065_1, aces, ACES - ACES2065-1, lin_ap0, lin_ap0_scene]
    family: ACES
    equalitygroup: ""
    bitdepth: 32f
    description: ACES Interchange format. Also known as AP0.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [0.439632981919, 0.382988698152, 0.177378319929, 0, 0.089776442959, 0.813439428749, 0.096784128292, 0, 0.017541170383, 0.111546553302, 0.870912276314, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: CIE-XYZ-D65
    aliases: [cie_xyz_d65_scene, lin_ciexyzd65_scene, CIE XYZ-D65 - Scene-referred]
    family: Utility
    equalitygroup: ""
    bitdepth: 32f
    description: CIE 1931 colorspace with D65 whitepoint.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [0.412390799266, 0.357584339384, 0.180480788402, 0, 0.212639005872, 0.715168678768, 0.072192315361, 0, 0.019330818716, 0.119194779795, 0.95053215225, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: BT.2020-linear
    aliases: [lin_bt2020, lin_rec2020, Linear Rec.2020, Utility - Linear - Rec.2020]
    family: Utility
    equalitygroup: ""
    bitdepth: 32f
    description: ITU-R BT.2020 colorspace with linear transfer-function. Wide gamut, D65 whitepoint.
    isdata: false
    allocation: uniform
    from_scene_reference: !<MatrixTransform> {matrix: [0.627403895935, 0.329283038378, 0.043313065687, 0, 0.069097289358, 0.919540395075, 0.011362315566, 0, 0.016391438875, 0.088013307877, 0.895595253248, 0, 0, 0, 0, 1]}
